  CImageResources *CImageResources::s_instance = NULL;
#ifndef CIMAGERESOURCES_IMPLEMENTATION
#define CIMAGERESOURCES_IMPLEMENTATION
 
 CImageResources::~CImageResources(void)
  {
  }
CImageResources *CImageResources::Instance()
  {
   if(s_instance == NULL)
      s_instance = new CImageResources();
   return(s_instance);
  }

void CImageResources::Destroy()
  {
   if(s_instance != NULL)
     {
      delete s_instance;
      s_instance = NULL;
     }
  }
 void CImageResources::SetData(const uint index, const string name, const uint width, const uint height, uint &data[])
  {
   if((int)index >= ArraySize(images)) ArrayResize(images, (int)index+1);
   images[index].name   = name;
   images[index].width  = width;
   images[index].height = height;
   ArrayCopy(images[index].data, data);
  }

 string CImageResources::GetData(const uint index, uint &image_data[], uint &image_width, uint &image_height)
  {
   if((int)index >= ArraySize(images))
    {
      Print(__FUNCTION__," > Preventing out-of-bounds array!");
      return("");
    }
   ArrayFree(image_data);
   image_width  = images[index].width;
   image_height = images[index].height;
   ArrayCopy(image_data, images[index].data);
   return(images[index].name);
  }

 //+------------------------------------------------------------------+
 //| Class Constructor - Digitized Data Initialization                |
 //+------------------------------------------------------------------+
 CImageResources::CImageResources(void)
  {
    ArrayResize(images, 247);
